# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard instead.
PIPEDRIVE_API_TOKEN=your-pipedrive-api-token
# Any random string of 24+ characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=replace-with-a-long-random-string
# Writes are OFF unless this is exactly "true". Even then add_note needs confirm=true on every call.
ALLOW_WRITES=false
# PORT=3000
# RATE_LIMIT_PER_MINUTE=120
